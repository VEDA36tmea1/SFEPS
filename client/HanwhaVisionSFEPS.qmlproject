import QmlProject 1.1

Project {
    mainFile: "src/Main.qml"
    
    QmlFiles {
        directory: "src"
    }

    QmlFiles {
        directory: "src/views"
    }

    ImageFiles {
        directory: "assets"
    }

    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }
}
