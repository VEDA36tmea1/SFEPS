/* Global Styles */
QWidget {
    background-color: #0a0a0a;
    /* Main App Background */
    color: #ffffff;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
}

/* Main Window Structure */
QMainWindow {
    background-color: #0a0a0a;
}

/* Sidebar */
QFrame#sidebar {
    background-color: #1a1a1a;
    border-right: 1px solid #333333;
}

QLabel#sidebar_title {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

QLabel#sidebar_subtitle {
    color: #a3a3a3;
    /* muted-foreground */
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Header */
QFrame#header {
    background-color: #0a0a0a;
    border-bottom: 1px solid #333333;
}

QLabel#header_title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
}

/* Cards */
QFrame#card {
    background-color: #1f1f1f;
    /* Surface/Card */
    border: 1px solid #333333;
    border-radius: 8px;
    /* rounded-lg */
}

/* Inputs */
QLineEdit {
    background-color: #2a2a2a;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 10px;
    color: #ffffff;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #ff6b2c;
    /* Primary Orange */
    background-color: #2a2a2a;
}

QLineEdit::placeholder {
    color: #a3a3a3;
}

/* Buttons */
QPushButton {
    background-color: #ff6b2c;
    /* Primary */
    color: #ffffff;
    border: none;
    border-radius: 6px;
    /* radius-md approx */
    padding: 10px 20px;
    font-weight: 500;
    /* font-medium */
    font-size: 14px;
}

QPushButton:hover {
    background-color: #ff8555;
    /* Primary Hover */
}

QPushButton:pressed {
    background-color: #e55a1b;
}

/* Ghost Button (Transparent) */
QPushButton#ghost {
    background-color: transparent;
    color: #a3a3a3;
    border: none;
}

QPushButton#ghost:hover {
    background-color: #262626;
    color: #ffffff;
}

/* Navigation Buttons (Sidebar) */
QPushButton#nav_item {
    background-color: transparent;
    color: #a3a3a3;
    text-align: left;
    padding: 12px 16px;
    border-radius: 6px;
    border: none;
    font-size: 14px;
}

QPushButton#nav_item:checked {
    background-color: #ff6b2c;
    color: #ffffff;
}

QPushButton#nav_item:hover {
    background-color: #262626;
    color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0a0a0a;
    width: 8px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #404040;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Typography Utilities */
QLabel#h1 {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#h2 {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#muted {
    color: #a3a3a3;
    font-size: 12px;
}

QLabel#primary {
    color: #ff6b2c;
}

.text-green {
    color: #22c55e;
}

.bg-green {
    background-color: #22c55e;
}
