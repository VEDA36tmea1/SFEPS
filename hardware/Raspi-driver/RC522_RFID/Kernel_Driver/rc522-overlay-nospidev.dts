/*
 * RC522 오버레이 (spidev 비활성화: 경로로 지정)
 * 메인 오버레이 실패 시 사용. CE0 spidev를 끄지 않으면 rc522가 probe 안 됨.
 * fragment@1 이 실패하면(경로 없음) 이 파일에서 fragment@1 블록 삭제 후 make dtbo 재시도.
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2711", "brcm,bcm2835";

	fragment@0 {
		target = <&spi0>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			rc522: rc522@0 {
				compatible = "nxp,rc522";
				reg = <0>;
				spi-max-frequency = <1000000>;
				reset-gpios = <&gpio 25 0>;
			};
		};
	};

	/* CE0 spidev 비활성화 (전체 경로). 적용 실패 시 이 fragment 삭제 후 make dtbo */
	fragment@1 {
		target-path = "/soc/spi@7e204000/spidev@0";
		__overlay__ {
			status = "disabled";
		};
	};
};
