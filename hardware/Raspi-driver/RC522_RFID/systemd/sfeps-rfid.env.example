# SFEPS RFID bootstrap environment
# Copy to: /etc/default/sfeps-rfid

# rc522 kernel module (.ko) path used for insmod fallback
SFEPS_RFID_KO_PATH=/home/iam/SFEPS/hardware/Raspi-driver/RC522_RFID/Kernel_Driver_irq/build/rc522.ko

# RFID UDS daemon binary
SFEPS_RFID_DAEMON_PATH=/home/iam/SFEPS/hardware/Raspi-driver/RC522_RFID/Server_examples/rc522_uds_daemon

# UDS socket path consumed by server/src/rfid_monitor.cpp
SFEPS_RFID_SOCKET_PATH=/tmp/rc522_events.sock

# UDS socket permissions/group
SFEPS_RFID_SOCKET_MODE=660
SFEPS_RFID_SOCKET_GROUP=iam

# Readiness checks
SFEPS_RFID_DEV_PATH=/dev/rc522
SFEPS_RFID_DEV_WAIT_SEC=10
SFEPS_RFID_SOCKET_WAIT_SEC=10
