SFEPS_DB_HOST=localhost
SFEPS_DB_USER=pi
SFEPS_DB_PASS=raspberry
SFEPS_DB_NAME_AUTH=CCgbd
SFEPS_DB_NAME_ANALYTICS=CCgbd

# MediaMTX input stream for recorder.cpp
SFEPS_RTSP_URL=rtsp://192.168.0.101:8554/cam1
SFEPS_RTSP_URL=rtsp://192.168.0.101:8554/cam1

SFEPS_APP_TLS_ENABLE=1
SFEPS_APP_PLAINTEXT_ENABLE=1
SFEPS_APP_BIND_IP=192.168.0.101
SFEPS_APP_BIND_IP=192.168.0.101
SFEPS_APP_TLS_CERT_FILE=/usr/local/etc/server.crt
SFEPS_APP_TLS_KEY_FILE=/usr/local/etc/server.key

SFEPS_AUTH_TLS_PORT=6555
SFEPS_AUDIO_TLS_PORT=6556
SFEPS_ALERT_TLS_PORT=6557
SFEPS_POSITION_TLS_PORT=6558
SFEPS_VIDEO_CATALOG_TLS_PORT=6559
SFEPS_VIDEO_CATALOG_PORT=5559
SFEPS_VIDEO_MAX_CLIENTS=32
SFEPS_VIDEO_HTTP_BASE_URL=http://192.168.0.101:8080/videos
SFEPS_FRAUD_IMAGE_HTTP_BASE_URL=http://192.168.0.101:8080/fraud-images
SFEPS_VIDEO_RETENTION_SEC=3000
SFEPS_VIDEO_HTTP_BASE_URL=http://192.168.0.101:8080/videos
SFEPS_FRAUD_IMAGE_HTTP_BASE_URL=http://192.168.0.101:8080/fraud-images
SFEPS_VIDEO_RETENTION_SEC=86400
SFEPS_VIDEO_MAX_STORAGE_BYTES=5368709120
SFEPS_VIDEO_STORAGE_RESUME_BYTES=3221225472
SFEPS_PENDING_IMAGE_RETENTION_SEC=30
SFEPS_FRAUD_IMAGE_RETENTION_SEC=86400
# Analytics pending 매칭 큐 제한
SFEPS_META_PENDING_MAX=2
SFEPS_META_PENDING_TTL_SEC=5
#qt로 보내는 속도
SFEPS_POSITION_MIN_SEND_MS=500
# Position 연결 종료 후 인증 해제 유예(ms)
SFEPS_AUTH_DEAUTH_GRACE_MS=3000

# Port allowlist (comma-separated exact IPs)
SFEPS_AUTH_ALLOW_IPS=*
SFEPS_AUDIO_ALLOW_IPS=*
SFEPS_ALERT_ALLOW_IPS=*

SFEPS_ESP_TCP_ENABLE=1
SFEPS_ESP_TCP_BIND_IP=0.0.0.0
SFEPS_ESP_TCP_PORT=5565
SFEPS_ESP_TCP_MAX_CLIENTS=4
# 필요 시만
# SFEPS_ESP_TCP_ALLOW_IPS=192.168.4.2

# ESP TRACK_POS 테스트 송신 (개발용)
SFEPS_ESP_TEST_TRACK_POS_ENABLE=0

SFEPS_ESP_TEST_TRACK_POS_INTERVAL_SEC=5
SFEPS_ESP_TEST_TRACK_POS_OBJECT_ID=DEV-TRACK-TEST
