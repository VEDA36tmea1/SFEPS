SFEPS_DB_HOST=localhost
SFEPS_DB_USER=pi
SFEPS_DB_PASS=raspberry
SFEPS_DB_NAME_AUTH=CCgbd
SFEPS_DB_NAME_ANALYTICS=CCgbd

# App port mode (current: plaintext only on 5555/5556/5557)
SFEPS_APP_TLS_ENABLE=0
SFEPS_APP_PLAINTEXT_ENABLE=1

# TLS ports and cert/key (prepared for future TLS switch)
SFEPS_AUTH_TLS_PORT=6555
SFEPS_AUDIO_TLS_PORT=6556
SFEPS_ALERT_TLS_PORT=6557
SFEPS_APP_TLS_CERT_FILE=/etc/ssl/certs/ssl-cert-snakeoil.pem
SFEPS_APP_TLS_KEY_FILE=/etc/ssl/private/ssl-cert-snakeoil.key
