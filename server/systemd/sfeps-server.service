[Unit]
Description=SFEPS Server
After=network-online.target mariadb.service mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=iam
Group=iam
WorkingDirectory=/home/iam/SFEPS/server
ExecStart=/home/iam/SFEPS/server/run_server.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
